# DAKSH ONLINE PRINTING — backend configuration template
# Copy to ".env" and fill with YOUR OWN account values.
# NEVER commit the real .env file. NEVER put these keys in the Android app.

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/daksh_printing

# App
JWT_SECRET=change-me-to-a-long-random-string
API_PORT=3000
JWT_EXPIRES_IN=30d

# OTP / SMS
# OTP_DEV_MODE=true logs OTP codes to the server console instead of
# sending an SMS. Development only — NEVER enable in production.
# Production SMS needs a real provider plugged into
# src/modules/auth/sms.provider.ts (see backend README).
OTP_DEV_MODE=false

# Google Sign-In (customer app "Continue with Google")
# The WEB client ID from Google Cloud Console → APIs & Services →
# Credentials. The app sends this as its server client ID, and the
# backend checks the Google ID token's audience (aud) against it.
# Leave empty to disable Google login (POST /auth/google returns 503).
GOOGLE_CLIENT_ID=

# Admin bootstrap (used once by `npm run create-admin`; you can remove
# these after the admin account exists)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Razorpay (Phase 5 — from your Razorpay dashboard)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shiprocket (Phase 6 — API user from your Shiprocket panel)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_POSTCODE=

# Firebase (push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Private file storage (S3-compatible)
STORAGE_BUCKET=
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Optional: set for S3-compatible providers (e.g. https://<account>.r2.cloudflarestorage.com)
STORAGE_ENDPOINT=
SIGNED_URL_EXPIRY_MINUTES=15

# File retention (days after delivery, then auto-delete uploads)
FILE_RETENTION_DAYS=30
